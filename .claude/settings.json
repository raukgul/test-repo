{
    "permissions":{
        "deny":[
            "Bash(git push --force *)",
            "Bash(git push -f *)",
            "Bash(git reset --hard *)"
        ]
    },
    "hooks":{
        "SessionStart":[
            {
                "hooks": [
                    { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.sh\"" }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-stubs.sh\"" },
                    { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-secrets.sh\"" }
                ]
            },
            {
                "matcher": "Bash",
                "hooks": [
                    { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-secrets.sh\"" }
                ]
            }
        ]
    }

}